# ~/.gitconfig
#
# ⚠️ 這個檔案只放「行為」，不放「身分」。
#
#   行為 = alias、diff 演算法、衝突樣式…… 換機器換公司都不會變 → 版控
#   身分 = name、email、SSH 金鑰……      會隨環境改變           → 不版控
#
# 身分設定在 ~/.gitconfig.local（見本檔最下方的 include）。
# 那個檔案不進 repo，所以這份設定在任何機器上都適用。
#
# 註解格式：每條寫「git 預設是什麼 / 這行改成什麼 / 不設會怎樣」，
# 方便你隨時回頭質疑任何一條。

# ─────────────────────────────────────────────────────────────────────
[user]
	# 預設：git 找不到 email 時，會自作主張用 <使用者名>@<主機名> 湊一個，
	#       然後靜默地把它寫進 commit。那個 email 會永久留在歷史裡。
	# 這行：禁止自動猜測。沒有明確設定就直接報錯。
	# 不設：在公司 repo 忘記切身分時，會安靜地用錯誤身分 commit —— 而且
	#       commit 進去的 email 公開 repo 上任何人都看得到。
	useConfigOnly = true

# ─────────────────────────────────────────────────────────────────────
[core]
	# 預設：看 $EDITOR / $VISUAL，都沒有就用 vi
	# 這行：明確指定，不依賴環境變數
	editor = vim

# ─────────────────────────────────────────────────────────────────────
[init]
	# 預設：master（並在每次 git init 時印一段警告說預設名稱將會改變）
	# 這行：新建的 repo 用 main
	# 範圍：**只影響 `git init`**。`git clone` 完全不看這個設定 ——
	#       clone 下來的分支名由遠端決定，公司 repo 是 master 就是 master。
	defaultBranch = main

# ─────────────────────────────────────────────────────────────────────
[push]
	# 預設：push 一個沒有 upstream 的新分支會失敗，並印出
	#       「請執行 git push --set-upstream origin <分支>」
	# 這行：直接推上去，順便把 upstream 設成 origin/<同名分支>
	# 判斷：它消除的是「把答案寫在裡面的錯誤訊息」，不是真正的檢查點。
	#       省掉的步驟沒有提供任何資訊 → 值得自動化。
	autoSetupRemote = true

# ─────────────────────────────────────────────────────────────────────
# [pull]
#	rebase = true
#
# 刻意不設。這會讓 `git pull` 在這台機器上靜默做別的事（rebase 而非 merge），
# 到別台機器上產生不同的歷史而你不會發現。「靜默地做別的事」是紅線。
# 要 rebase 式 pull 就明確用 alias，讓意圖寫在指令上而不是藏在設定裡。

# ─────────────────────────────────────────────────────────────────────
[fetch]
	# 預設：遠端刪掉的分支，你本地的 origin/xxx 參照會一直留著，越積越多
	# 這行：fetch 時自動清掉已不存在的遠端分支參照
	# 不設：`git branch -a` 會列出一堆早就被刪掉的分支
	prune = true

# ─────────────────────────────────────────────────────────────────────
[rerere]
	# REuse REcorded REsolution
	# 預設：關閉。每次遇到衝突都要從頭解一次，即使是解過一模一樣的
	# 這行：記住衝突的解法，下次遇到相同衝突自動套用
	# 為什麼重要：rebase 一長串 commit 時，同一個衝突可能重複出現五次。
	#             這是「rebase 很痛」最主要的來源之一。
	enabled = true
	# 自動把記住的解法直接套進暫存區，不用再手動 git add
	autoUpdate = true

# ─────────────────────────────────────────────────────────────────────
[diff]
	# 預設：myers 演算法
	# 這行：histogram。更會辨識「整塊搬移」的程式碼，
	#       不會把一次搬移顯示成「刪掉 20 行 + 新增 20 行」
	algorithm = histogram

[merge]
	# 預設：merge 樣式只顯示雙方的版本：
	#         <<<<<<< 我的
	#         =======
	#         >>>>>>> 對方
	#       你看得到兩個結果，但看不出各自改了什麼。
	# 這行：zdiff3 會多顯示「共同祖先」的內容：
	#         <<<<<<< 我的
	#         ||||||| 原本長這樣   ← 多這段
	#         =======
	#         >>>>>>> 對方
	#       有了原始版本，才判斷得出誰動了什麼、該保留哪邊。
	conflictstyle = zdiff3

# ─────────────────────────────────────────────────────────────────────
[log]
	# 預設：Fri Aug 15 17:38:02 2026 +0800（人類可讀但排序困難）
	# 這行：2026-08-15 17:38:02 +0800（可排序、可比對、國際標準）
	date = iso

[column]
	# 預設：git branch、git tag 的輸出是一行一項，很長的清單要捲很久
	# 這行：終端機夠寬時自動排成多欄
	ui = auto

[branch]
	# 預設：git branch 依字母順序列出
	# 這行：依最後 commit 時間排序，最近動過的在最上面
	#       （前面加負號代表由新到舊）
	sort = -committerdate

# ─────────────────────────────────────────────────────────────────────
# git alias：這些是「git 層」的 alias，任何 shell 都有效但要打 git 開頭。
# shell 層的短寫（gst、gd…）由 oh-my-zsh 提供，見 zsh/custom/40-git.zsh。
[alias]
	st = status --short --branch
	# --graph 畫分支線、--oneline 一行一個 commit、--decorate 顯示分支標籤、
	# --all 包含所有分支（不只當前這條）
	lg = log --graph --oneline --decorate --all
	last = log -1 --stat
	# 把檔案移出暫存區，但保留工作目錄的修改
	unstage = restore --staged
	# 修改最後一個 commit 的內容，但不改訊息（--no-edit 就是不開編輯器）
	amend = commit --amend --no-edit
	# 撤銷最後一個 commit，但把變更留在暫存區（--soft = 不動檔案）
	undo = reset --soft HEAD~1
	# 追蹤單一檔案的完整變更歷史，--follow 讓它跨越改名
	filelog = log --follow -p --
	# -vv 顯示每個分支追蹤哪個遠端分支、領先/落後幾個 commit
	branches = branch -vv --sort=-committerdate

# ─────────────────────────────────────────────────────────────────────
# 身分與機器專屬設定。這個檔案不版控。
# git 對於「include 的檔案不存在」是靜默略過的，所以缺了也不會壞 ——
# 只是 commit 時會因為 useConfigOnly 而報錯要你設定身分，那正是我們要的。
[include]
	path = ~/.gitconfig.local
